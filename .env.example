# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# Base URL (frontend + backend)
SITE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Database (Postgres via docker-compose)
POSTGRES_DB=cyonima
POSTGRES_USER=cyonima
POSTGRES_PASSWORD=cyonima
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Mettre à true pour un dev rapide sans Postgres (SQLite)
USE_SQLITE=false

# Redis (channels + celery)
REDIS_URL=redis://localhost:6379/0
# Mettre à true si Redis n'est pas disponible en dev (channel layer en mémoire)
USE_IN_MEMORY_CHANNEL=false

# Ollama (shared server)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:7b

# Docker sandbox
SANDBOX_IMAGE=cyonima/sandbox:latest
SANDBOX_VOLUME_ROOT=./sandbox/workspaces
# Utilisateur non-root du sandbox (doit correspondre à l'UID/GID du backend)
SANDBOX_UID=1000
SANDBOX_GID=1000
# Durcissement
SANDBOX_CAP_DROP=ALL
SANDBOX_MEM_LIMIT=2g
SANDBOX_CPU_LIMIT=1.0
SANDBOX_PIDS_LIMIT=512
SANDBOX_READ_ONLY=true
SANDBOX_TMPFS_SIZE=1g

# Auth (django-allauth)
# SSO OIDC (Entra ID, Okta, Google, Keycloak…) — un provider configurable via env.
# Laissez OIDC_CLIENT_ID vide pour désactiver le SSO.
OIDC_PROVIDER_ID=oidc
OIDC_NAME=SSO
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SERVER_URL=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Production (docker-compose.prod.yml)
IMAGE_PREFIX=ghcr.io/owner/repo
IMAGE_TAG=latest
