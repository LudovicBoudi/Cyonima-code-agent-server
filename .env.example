# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# Base URL (frontend + backend)
SITE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Database (Postgres via docker-compose)
POSTGRES_DB=cyonima
POSTGRES_USER=cyonima
POSTGRES_PASSWORD=cyonima
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Mettre à true pour un dev rapide sans Postgres (SQLite)
USE_SQLITE=false

# Redis (channels + celery)
REDIS_URL=redis://localhost:6379/0
# Mettre à true si Redis n'est pas disponible en dev (channel layer en mémoire)
USE_IN_MEMORY_CHANNEL=false

# Ollama (shared server)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:7b

# Docker sandbox
SANDBOX_IMAGE=cyonima/sandbox:latest
SANDBOX_VOLUME_ROOT=./sandbox/workspaces

# Auth (django-allauth)
# ACCOUNT_DEFAULT_HTTP_PROTOCOL=https
# OIDC / SAML providers are configured via Django admin (social apps),
# or via env for the common ones:
# OIDC_RP_CLIENT_ID=
# OIDC_RP_CLIENT_SECRET=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
